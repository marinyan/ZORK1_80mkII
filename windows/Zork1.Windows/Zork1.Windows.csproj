<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Zork1Japanese</AssemblyName>
    <RootNamespace>Zork1Japanese</RootNamespace>
    <!-- ビルド番号は、この採番を導入する13番目のリポジトリ履歴から開始する。 -->
    <PortVersionMajor>0</PortVersionMajor>
    <PortVersionMinor>1</PortVersionMinor>
    <PortBuildNumber>18</PortBuildNumber>
    <Version>$(PortVersionMajor).$(PortVersionMinor).$(PortBuildNumber)</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Zork I Japanese Windows Port</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\references\zork1\COMPILED\zork1.z3" LogicalName="Zork1Japanese.zork1.z3" />
    <Content Include="..\..\translation\ja\*.tsv">
      <Link>lang\ja\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\translation\en\*.tsv">
      <Link>lang\en\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
